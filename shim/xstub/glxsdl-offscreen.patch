+/* GLXSDL_OFFSCREEN=1: the game draws into a framebuffer object the size of the window instead of the window itself,
+ * and every swap draws it to the window. Unity 4 copies its screen into textures (image effects, GrabPass): from the
+ * window surface some drivers do that wrong on the GPU (RK3326 libmali: black world, missing sprites), so gl4es would
+ * have to read it back on the CPU; from an FBO it is a plain GPU copy. The FBO is made through gl4es, so gl4es tracks
+ * it like any game FBO, and the game's binds of framebuffer 0 go to it (glBindFramebuffer* from glXGetProcAddress).
+ * The draw to the window calls the GLES driver directly and puts back every bit of GLES state it touches, so gl4es's
+ * cache of that state stays true. */
+static int offscreen;
+static GLuint off_fbo, raw_tex, blit_prog;              /* off_fbo: gl4es's name; raw_tex: the driver's */
+typedef void (*bindfb_fn)(GLenum, GLuint);
+static bindfb_fn gl4es_bindfb;
+static struct {
+    void (*GetIntegerv)(GLenum, GLint *); void (*GetBooleanv)(GLenum, unsigned char *); unsigned char (*IsEnabled)(GLenum);
+    void (*Enable)(GLenum), (*Disable)(GLenum), (*UseProgram)(GLuint), (*ActiveTexture)(GLenum);
+    void (*BindFramebuffer)(GLenum, GLuint), (*BindTexture)(GLenum, GLuint), (*BindBuffer)(GLenum, GLuint);
+    void (*Viewport)(GLint, GLint, GLsizei, GLsizei); void (*ColorMask)(unsigned char, unsigned char, unsigned char, unsigned char);
+    void (*GetVertexAttribiv)(GLuint, GLenum, GLint *); void (*GetVertexAttribPointerv)(GLuint, GLenum, void **);
+    void (*VertexAttribPointer)(GLuint, GLint, GLenum, unsigned char, GLsizei, const void *);
+    void (*EnableVertexAttribArray)(GLuint), (*DisableVertexAttribArray)(GLuint); void (*DrawArrays)(GLenum, GLint, GLsizei);
+} gl;
+
+static void blit_to_window(void)
+{
+    static const float quad[] = { -1, -1, 1, -1, -1, 1, 1, 1 };
+    static const GLenum caps[] = { 0x0BE2, 0x0B71, 0x0B44, 0x0C11, 0x0B90, 0x809E };   /* blend depth cull scissor stencil alpha-to-coverage */
+    GLint fb, vp[4], prog, unit, tex, buf, en, size, type, norm, stride, abuf; void *ptr; unsigned char mask[4], on[6];
+    gl.GetIntegerv(0x8CA6, &fb); gl.GetIntegerv(0x0BA2, vp); gl.GetIntegerv(0x8B8D, &prog); gl.GetIntegerv(0x84E0, &unit);
+    gl.GetBooleanv(0x0C23, mask);                       /* FRAMEBUFFER_BINDING, VIEWPORT, CURRENT_PROGRAM, ACTIVE_TEXTURE, COLOR_WRITEMASK */
+    for (int i = 0; i < 6; i++) if ((on[i] = gl.IsEnabled(caps[i]))) gl.Disable(caps[i]);
+    gl.ActiveTexture(0x84C0); gl.GetIntegerv(0x8069, &tex); gl.GetIntegerv(0x8894, &buf);   /* TEXTURE0: BINDING_2D; ARRAY_BUFFER_BINDING */
+    gl.GetVertexAttribiv(0, 0x8622, &en); gl.GetVertexAttribiv(0, 0x8623, &size); gl.GetVertexAttribiv(0, 0x8625, &type);
+    gl.GetVertexAttribiv(0, 0x886A, &norm); gl.GetVertexAttribiv(0, 0x8624, &stride); gl.GetVertexAttribiv(0, 0x889F, &abuf);
+    gl.GetVertexAttribPointerv(0, 0x8645, &ptr);        /* attribute 0: enabled, size, type, normalized, stride, buffer, pointer */
+
+    gl.BindFramebuffer(0x8D40, 0); gl.Viewport(0, 0, win_w, win_h); gl.ColorMask(1, 1, 1, 1);
+    gl.UseProgram(blit_prog); gl.BindTexture(0x0DE1, raw_tex); gl.BindBuffer(0x8892, 0);
+    gl.EnableVertexAttribArray(0); gl.VertexAttribPointer(0, 2, 0x1406, 0, 0, quad);
+    gl.DrawArrays(0x0005, 0, 4);                        /* TRIANGLE_STRIP */
+
+    gl.BindBuffer(0x8892, abuf); gl.VertexAttribPointer(0, size, type, norm, stride, ptr);
+    if (!en) gl.DisableVertexAttribArray(0);
+    gl.BindBuffer(0x8892, buf); gl.BindTexture(0x0DE1, tex); gl.ActiveTexture(unit); gl.UseProgram(prog);
+    gl.ColorMask(mask[0], mask[1], mask[2], mask[3]); gl.Viewport(vp[0], vp[1], vp[2], vp[3]);
+    for (int i = 0; i < 6; i++) if (on[i]) gl.Enable(caps[i]);
+    gl.BindFramebuffer(0x8D40, fb);
+}
+
+static void bindfb(GLenum target, GLuint fb) { gl4es_bindfb(target, fb ? fb : off_fbo); }
+
+static int offscreen_init(void)
+{
+#define G(name) if (!(*(void **)&gl.name = getproc("gl" #name))) return 0;
+    G(GetIntegerv) G(GetBooleanv) G(IsEnabled) G(Enable) G(Disable) G(UseProgram) G(ActiveTexture) G(BindFramebuffer)
+    G(BindTexture) G(BindBuffer) G(Viewport) G(ColorMask) G(GetVertexAttribiv) G(GetVertexAttribPointerv)
+    G(VertexAttribPointer) G(EnableVertexAttribArray) G(DisableVertexAttribArray) G(DrawArrays)
+    GLuint (*createshader)(GLenum) = getproc("glCreateShader"), (*createprogram)(void) = getproc("glCreateProgram");
+    void (*source)(GLuint, GLsizei, const char *const *, const GLint *) = getproc("glShaderSource");
+    void (*compile)(GLuint) = getproc("glCompileShader"), (*attach)(GLuint, GLuint) = getproc("glAttachShader");
+    void (*bindattrib)(GLuint, GLuint, const char *) = getproc("glBindAttribLocation"), (*link)(GLuint) = getproc("glLinkProgram");
+    void (*getprogiv)(GLuint, GLenum, GLint *) = getproc("glGetProgramiv");
+    void (*getattach)(GLenum, GLenum, GLenum, GLint *) = getproc("glGetFramebufferAttachmentParameteriv");
+    if (!createshader || !createprogram || !source || !compile || !attach || !bindattrib || !link || !getprogiv || !getattach) return 0;
+    static const char *vs = "attribute vec2 p; varying vec2 t; void main() { t = p * 0.5 + 0.5; gl_Position = vec4(p, 0.0, 1.0); }";
+    static const char *fs = "precision mediump float; varying vec2 t; uniform sampler2D s; void main() { gl_FragColor = vec4(texture2D(s, t).rgb, 1.0); }";
+    GLuint v = createshader(0x8B31), f = createshader(0x8B30);   /* VERTEX_SHADER, FRAGMENT_SHADER; sampler s = unit 0 by default */
+    source(v, 1, &vs, NULL); source(f, 1, &fs, NULL); compile(v); compile(f);
+    blit_prog = createprogram(); attach(blit_prog, v); attach(blit_prog, f); bindattrib(blit_prog, 0, "p"); link(blit_prog);
+    GLint ok = 0; getprogiv(blit_prog, 0x8B82, &ok);   /* LINK_STATUS */
+    if (!ok) return 0;
+
+    /* the FBO through gl4es: RGBA8 texture + packed depth/stencil 24/8 (what the game gets from GLX) */
+    void (*gentex)(GLsizei, GLuint *) = p_gl4es_GetProcAddress("glGenTextures"), (*bindtex)(GLenum, GLuint) = p_gl4es_GetProcAddress("glBindTexture");
+    void (*texparam)(GLenum, GLenum, GLint) = p_gl4es_GetProcAddress("glTexParameteri");
+    void (*teximage)(GLenum, GLint, GLint, GLsizei, GLsizei, GLint, GLenum, GLenum, const void *) = p_gl4es_GetProcAddress("glTexImage2D");
+    void (*genfb)(GLsizei, GLuint *) = p_gl4es_GetProcAddress("glGenFramebuffers"), (*genrb)(GLsizei, GLuint *) = p_gl4es_GetProcAddress("glGenRenderbuffers");
+    void (*bindrb)(GLenum, GLuint) = p_gl4es_GetProcAddress("glBindRenderbuffer");
+    void (*rbstorage)(GLenum, GLenum, GLsizei, GLsizei) = p_gl4es_GetProcAddress("glRenderbufferStorage");
+    void (*fbtex)(GLenum, GLenum, GLenum, GLuint, GLint) = p_gl4es_GetProcAddress("glFramebufferTexture2D");
+    void (*fbrb)(GLenum, GLenum, GLenum, GLuint) = p_gl4es_GetProcAddress("glFramebufferRenderbuffer");
+    GLenum (*status)(GLenum) = p_gl4es_GetProcAddress("glCheckFramebufferStatus");
+    void (*clear)(unsigned) = p_gl4es_GetProcAddress("glClear");
+    gl4es_bindfb = (bindfb_fn)p_gl4es_GetProcAddress("glBindFramebuffer");
+    if (!gentex || !bindtex || !texparam || !teximage || !genfb || !genrb || !bindrb || !rbstorage || !fbtex || !fbrb || !status || !clear || !gl4es_bindfb) return 0;
+    GLuint t, rb;
+    gentex(1, &t); bindtex(0x0DE1, t);
+    texparam(0x0DE1, 0x2801, 0x2600); texparam(0x0DE1, 0x2800, 0x2600);   /* MIN/MAG_FILTER NEAREST */
+    texparam(0x0DE1, 0x2802, 0x812F); texparam(0x0DE1, 0x2803, 0x812F);   /* WRAP_S/T CLAMP_TO_EDGE */
+    teximage(0x0DE1, 0, 0x1908, win_w, win_h, 0, 0x1908, 0x1401, NULL);   /* RGBA, UNSIGNED_BYTE */
+    bindtex(0x0DE1, 0);
+    genrb(1, &rb); bindrb(0x8D41, rb); rbstorage(0x8D41, 0x88F0, win_w, win_h); bindrb(0x8D41, 0);   /* DEPTH24_STENCIL8 */
+    genfb(1, &off_fbo); gl4es_bindfb(0x8D40, off_fbo);
+    fbtex(0x8D40, 0x8CE0, 0x0DE1, t, 0);                 /* COLOR_ATTACHMENT0 */
+    fbrb(0x8D40, 0x8D00, 0x8D41, rb); fbrb(0x8D40, 0x8D20, 0x8D41, rb);   /* DEPTH and STENCIL_ATTACHMENT */
+    if (status(0x8D40) != 0x8CD5) { gl4es_bindfb(0x8D40, 0); return 0; }  /* FRAMEBUFFER_COMPLETE */
+    getattach(0x8D40, 0x8CE0, 0x8CD1, (GLint *)&raw_tex);                 /* ATTACHMENT_OBJECT_NAME: the driver's texture */
+    clear(0x4000 | 0x0100 | 0x0400);
+    return 1;
+}
+
 static void swap(void)
 {
     if (p_gl4es_pre_swap) p_gl4es_pre_swap();
+    if (offscreen) blit_to_window();
     p_SDL_GL_SwapWindow(win);
     if (p_gl4es_post_swap) p_gl4es_post_swap();
 }
